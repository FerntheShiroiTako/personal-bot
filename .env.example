# Bot token from Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=your-discord-bot-token-here
# Your own Discord user ID (Developer Mode on -> right-click yourself -> Copy User ID)
OWNER_ID=123456789012345678
# Rayward API key (create at https://rayward.app), one key covers all five sources
RAYWARD_API_KEY=rwd_your_key_here
